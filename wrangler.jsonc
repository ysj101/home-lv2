{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-lv2",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    // Cloudflare Access の Team domain と AUD タグ。取得方法は docs/cloudflare-access.md。
    // どちらもシークレットではないのでここにコミットしてよい。
    // 空のままだと fail closed（常に設定エラー（500））。
    // ローカル開発用の DEV_USER_EMAIL はここには置かない。.dev.vars に書く
    // （本番ビルドでは読み取り自体がコードから消えるため設定しても効かない）。
    "CF_ACCESS_TEAM_DOMAIN": "ysj101.cloudflareaccess.com",
    "CF_ACCESS_AUD": "80c3ca1b43f7733681ef39b53643cb4bb3883c8efb4f0101525b2aee3d262f2e"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "home-lv2-db",
      "database_id": "c2910ade-7546-417b-98e7-2c77d4689ab4",
      // drizzle.config.ts の `out` と一致させること
      "migrations_dir": "src/db/migrations"
    }
  ]
}
